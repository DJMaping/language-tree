{
  "name": "andah-language-tree",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone visualizer/editor for Andah conlang family trees over time.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "open": "node server.js --open",
    "validate": "node scripts/validate.js",
    "test": "node scripts/test.js && node scripts/test-engine.js && node scripts/test-generator.js && node scripts/test-variation.js && node scripts/test-panel.js && node scripts/test-scripts.js && node scripts/test-translate.js",
    "test:scripts": "node scripts/test-scripts.js",
    "scripts:history": "node scripts/build-script-history.js",
    "fonts": "node scripts/build-fonts.js",
    "test:app": "node scripts/test.js",
    "test:engine": "node scripts/test-engine.js",
    "check": "node scripts/lang-check.js",
    "audit": "node scripts/lang-audit.js",
    "scorecard": "node scripts/lang-scorecard.js",
    "pin": "node scripts/lang-pin.js",
    "character": "node scripts/lang-character.js",
    "views": "node scripts/build-views.js",
    "lastnu": "node scripts/build-lastnu.js",
    "typology": "node scripts/typology-score.js",
    "report": "node scripts/lang-report.js",
    "test:generator": "node scripts/test-generator.js",
    "test:variation": "node scripts/test-variation.js",
    "variation": "node scripts/lang-variation.js",
    "names": "node scripts/lang-names.js",
    "earth": "node scripts/lang-vs-earth.js",
    "earth-map": "node scripts/build-earth.js",
    "years": "python scripts/build-years.py all",
    "years-languages": "python scripts/build-years.py languages",
    "dialects": "python scripts/build-years.py dialects && node scripts/build-dialects.js && python scripts/build-years.py languages",
    "export": "node scripts/lang-export.js",
    "test:panel": "node scripts/test-panel.js",
    "correspond": "node scripts/lang-correspond.js",
    "scripts": "node scripts/build-scripts.js",
    "check:loans": "node --max-old-space-size=20000 scripts/check-loans.js",
    "scripts:lock": "node scripts/lock-scripts.js",
    "test:translate": "node scripts/test-translate.js"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7"
  }
}
